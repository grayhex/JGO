// Regenerates apps/api/src/ngageSnapshot.ts from the live All About Symbian directory:
//   node --import tsx tools/catalog/aas-snapshot.mts
// The snapshot is only titles, genres, publishers and years (facts); covers and details are still fetched on demand.
import { writeFileSync } from 'node:fs';
import { AAS_INDEX, AAS_ORIGIN, parseAasIndex } from '../../apps/api/src/ngageCatalog.ts';
const html = await (await fetch(AAS_ORIGIN + AAS_INDEX, { headers: { 'user-agent': 'MGO metadata/1.0' } })).text();
const entries = parseAasIndex(html);
const rows = entries.map(e => `  ${JSON.stringify(e)},`).join('\n');
writeFileSync(new URL('../../apps/api/src/ngageSnapshot.ts', import.meta.url), `// Generated by tools/catalog/aas-snapshot.mts from ${AAS_ORIGIN}${AAS_INDEX} (All About Symbian). Do not edit by hand.
// Only the facts of the released N-Gage Classic games (title, genre, publisher, year, page, thumbnail address): enough to recognise
// a game and fill in its genre when the live directory cannot be reached. Covers and details are fetched on demand.
import type { CatalogEntry } from './ngageCatalog.js';
export const AAS_SNAPSHOT_DATE = '${new Date().toISOString().slice(0, 10)}';
export const AAS_SNAPSHOT: CatalogEntry[] = [
${rows}
];
`);
console.log(entries.length, 'entries');
