diff --git a/src/main/emulator/ui/bridge/BridgeCaret.java b/src/main/emulator/ui/bridge/BridgeCaret.java
new file mode 100644
index 00000000..9c418990
--- /dev/null
+++ b/src/main/emulator/ui/bridge/BridgeCaret.java
@@ -0,0 +1,163 @@
+package emulator.ui.bridge;
+
+import emulator.Emulator;
+import emulator.ui.ICaret;
+
+import javax.microedition.lcdui.TextBox;
+import javax.microedition.lcdui.TextField;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * j2me-web: the Bridge counterpart of the SWT CaretImpl. The SWT frontend lays a native text widget over
+ * the focused TextField; here the client does the typing. The focused text area is announced with the
+ * Bridge "A" packet (x, y, w, h as shorts + UTF-8 text; no data = no text area) and, before it, with the
+ * JGO extension packet "N" (u32 maxSize | u32 constraints | u8 'F' TextField or 'B' TextBox) that carries
+ * what the client needs to edit the text the way a phone would. The client answers with "E" (see BridgeInput).
+ */
+final class BridgeCaret implements ICaret {
+
+	private final BridgeFrontend bridge;
+	private Object item;
+	private byte[] lastSent;
+	private int areaX, areaY;
+
+	BridgeCaret(BridgeFrontend bridge) {
+		this.bridge = bridge;
+	}
+
+	@Override
+	public synchronized void focusItem(Object it, int x, int y) {
+		if (it instanceof TextField) {
+			TextField tf = (TextField) it;
+			item = tf;
+			send(x, y, tf._getTextAreaWidth(), tf._getTextAreaHeight(), tf.getString(), tf.getMaxSize(), tf.getConstraints(), 'F');
+		} else if (it instanceof TextBox) {
+			TextBox tb = (TextBox) it;
+			item = tb;
+			send(0, 0, Emulator.getEmulator().getScreen().getWidth(), Emulator.getEmulator().getScreen().getHeight(),
+					tb.getString(), tb.getMaxSize(), tb.getConstraints(), 'B');
+		}
+		// DateField and the Nokia TextEditor are not editable through the Bridge
+	}
+
+	@Override
+	public synchronized void defocusItem(Object it) {
+		if (it != item) return;
+		clear();
+	}
+
+	@Override
+	public int getCaretPosition() {
+		if (item instanceof TextField) return ((TextField) item).size();
+		if (item instanceof TextBox) return ((TextBox) item).size();
+		return 0;
+	}
+
+	@Override
+	public synchronized void displayableChanged() {
+		clear();
+	}
+
+	@Override
+	public synchronized void updateText(Object it, String text) {
+		if (it != item || item == null) return;
+		resend();
+	}
+
+	@Override
+	public void setSelection(int index, int length) {
+	}
+
+	@Override
+	public String getSelection() {
+		return "";
+	}
+
+	@Override
+	public void setCaret(int index) {
+	}
+
+	/** Applies the text typed by the client ("E"); returns quietly when nothing is focused. */
+	synchronized void typed(String text) {
+		if (item instanceof TextField) {
+			TextField tf = (TextField) item;
+			if (tf._isUneditable()) return;
+			String s = sanitize(text, tf.getConstraints(), tf.getMaxSize());
+			if (!s.equals(tf.getString())) tf._setString(s);
+		} else if (item instanceof TextBox) {
+			TextBox tb = (TextBox) item;
+			if ((tb.getConstraints() & TextField.UNEDITABLE) != 0) return;
+			String s = sanitize(text, tb.getConstraints(), tb.getMaxSize());
+			if (!s.equals(tb.getString())) tb.setString(s);
+		} else {
+			return;
+		}
+		Emulator.getEventQueue().queueRepaint();
+		resend();
+	}
+
+	private void resend() {
+		lastSent = null; // the client is told the (possibly sanitized) text even if the area is unchanged
+		if (item instanceof TextField) {
+			TextField tf = (TextField) item;
+			send(areaX, areaY, tf._getTextAreaWidth(), tf._getTextAreaHeight(), tf.getString(), tf.getMaxSize(), tf.getConstraints(), 'F');
+		} else if (item instanceof TextBox) {
+			TextBox tb = (TextBox) item;
+			send(0, 0, Emulator.getEmulator().getScreen().getWidth(), Emulator.getEmulator().getScreen().getHeight(),
+					tb.getString(), tb.getMaxSize(), tb.getConstraints(), 'B');
+		}
+	}
+
+	private void send(int x, int y, int w, int h, String text, int maxSize, int constraints, char kind) {
+		areaX = x;
+		areaY = y;
+		byte[] t = (text == null ? "" : text).getBytes(StandardCharsets.UTF_8);
+		ByteBuffer bb = ByteBuffer.allocate(8 + t.length);
+		bb.putShort((short) x).putShort((short) y).putShort((short) w).putShort((short) h).put(t);
+		byte[] area = bb.array();
+		ByteBuffer info = ByteBuffer.allocate(9);
+		info.putInt(maxSize).putInt(constraints).put((byte) kind);
+		byte[] n = info.array();
+		byte[] both = new byte[area.length + n.length];
+		System.arraycopy(n, 0, both, 0, n.length);
+		System.arraycopy(area, 0, both, n.length, area.length);
+		if (lastSent != null && java.util.Arrays.equals(lastSent, both)) return;
+		lastSent = both;
+		bridge.sendToState('N', n);
+		bridge.sendToState('A', area);
+	}
+
+	private void clear() {
+		item = null;
+		lastSent = null;
+		bridge.sendToState('A', new byte[0]);
+	}
+
+	static String sanitize(String text, int constraints, int maxSize) {
+		StringBuilder sb = new StringBuilder();
+		int mode = constraints & TextField.CONSTRAINT_MASK;
+		boolean dot = false;
+		for (int i = 0; i < text.length(); i++) {
+			char c = text.charAt(i);
+			boolean ok;
+			switch (mode) {
+				case TextField.NUMERIC:
+					ok = (c >= '0' && c <= '9') || (c == '-' && sb.length() == 0);
+					break;
+				case TextField.DECIMAL:
+					ok = (c >= '0' && c <= '9') || (c == '-' && sb.length() == 0) || (c == '.' && !dot);
+					if (ok && c == '.') dot = true;
+					break;
+				case TextField.PHONENUMBER:
+					ok = (c >= '0' && c <= '9') || c == '*' || c == '#' || (c == '+' && sb.length() == 0);
+					break;
+				default:
+					ok = c >= ' ' || c == '\n';
+			}
+			if (ok) sb.append(c);
+		}
+		if (sb.length() > maxSize) sb.setLength(maxSize);
+		return sb.toString();
+	}
+}
