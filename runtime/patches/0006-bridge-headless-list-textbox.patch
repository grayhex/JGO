diff --git a/src/main/emulator/lcdui/ListHeadless.java b/src/main/emulator/lcdui/ListHeadless.java
new file mode 100644
index 00000000..92f42f71
--- /dev/null
+++ b/src/main/emulator/lcdui/ListHeadless.java
@@ -0,0 +1,136 @@
+package emulator.lcdui;
+
+import emulator.Emulator;
+import javax.microedition.lcdui.Choice;
+import javax.microedition.lcdui.Font;
+import javax.microedition.lcdui.Graphics;
+import javax.microedition.lcdui.Image;
+import javax.microedition.lcdui.List;
+
+/**
+ * j2me-web: software List for the Bridge (headless) frontend. ListSWT builds SWT widgets, which do not
+ * exist there (the constructor died with an NPE and took the MIDlet with it). This keeps the same
+ * Choice model (ChoiceImpl) and draws the items into the framebuffer like Form/Alert are drawn.
+ */
+public class ListHeadless implements IListImpl {
+	private final List list;
+	private final int type;
+	private final ChoiceImpl choiceImpl;
+	private int focus; // item under the cursor (IMPLICIT/EXCLUSIVE follow the selection)
+	private int top; // first visible item
+
+	public ListHeadless(List list, String title, int type, String[] text, Image[] img) {
+		if (type != Choice.IMPLICIT && type != Choice.EXCLUSIVE && type != Choice.MULTIPLE) {
+			throw new IllegalArgumentException();
+		}
+		this.list = list;
+		this.type = type;
+		choiceImpl = new ChoiceImpl(type == Choice.MULTIPLE);
+		choiceImpl.check(text, img);
+		for (int i = 0; i < text.length; i++) {
+			choiceImpl.append(text[i], img != null ? img[i] : null);
+		}
+	}
+
+	// ---- Choice -------------------------------------------------------------------------------
+	public int append(String text, Image img) { return choiceImpl.append(text, img); }
+	public void insert(int position, String text, Image img) { choiceImpl.insert(position, text, img); }
+	public void set(int position, String text, Image img) { choiceImpl.set(position, text, img); }
+	public void delete(int position) { choiceImpl.delete(position); clamp(); }
+	public void deleteAll() { choiceImpl.deleteAll(); focus = top = 0; }
+	public int getFitPolicy() { return choiceImpl.getFitPolicy(); }
+	public Font getFont(int position) { return choiceImpl.getFont(position); }
+	public Image getImage(int position) { return choiceImpl.getImage(position); }
+	public String getString(int position) { return choiceImpl.getString(position); }
+	public int getSelectedFlags(boolean[] selectedArray) { return choiceImpl.getSelectedFlags(selectedArray); }
+	public int getSelectedIndex() { return choiceImpl.getSelectedIndex(); }
+	public boolean isSelected(int position) { return choiceImpl.isSelected(position); }
+	public void setFitPolicy(int newFitPolicy) { choiceImpl.setFitPolicy(newFitPolicy); }
+	public void setFont(int position, Font font) { choiceImpl.setFont(position, font); }
+	public void setSelectedFlags(boolean[] selectedArray) { choiceImpl.setSelectedFlags(selectedArray); }
+	public void setSelectedIndex(int position, boolean select) { choiceImpl.setSelected(position, select); focus = position; }
+	public int size() { return choiceImpl.size(); }
+
+	private void clamp() {
+		int n = choiceImpl.size();
+		if (focus >= n) focus = Math.max(0, n - 1);
+		if (top > focus) top = focus;
+	}
+
+	// ---- input (called from List._keyScroll / _invokeKeyPressed) ----------------------------------
+	public void keyScroll(int dir) {
+		int n = choiceImpl.size();
+		if (n == 0) return;
+		if (dir == javax.microedition.lcdui.Canvas.UP) focus = (focus + n - 1) % n;
+		else if (dir == javax.microedition.lcdui.Canvas.DOWN) focus = (focus + 1) % n;
+		else return;
+		if (type != Choice.MULTIPLE) choiceImpl.setSelected(focus, true);
+	}
+
+	public void keyFire() {
+		int n = choiceImpl.size();
+		if (n == 0) return;
+		if (type == Choice.MULTIPLE) choiceImpl.setSelected(focus, !choiceImpl.isSelected(focus));
+		else choiceImpl.setSelected(focus, true);
+		if (type == Choice.IMPLICIT) Emulator.getEventQueue().commandAction(list._getSelectCommand(), list);
+	}
+
+	// ---- painting ---------------------------------------------------------------------------------
+	public void layout() { }
+
+	private int rowHeight() { return Font.getDefaultFont().getHeight() + 4; }
+
+	public void paint(Graphics g) {
+		Font f = Font.getDefaultFont();
+		int w = getWidth(), h = getHeight();
+		int y0 = f.getHeight() + 4, rh = rowHeight();
+		int visible = Math.max(1, (h - y0 - rh) / rh);
+		int n = choiceImpl.size();
+		if (type != Choice.MULTIPLE && n > 0) focus = Math.max(0, Math.min(n - 1, choiceImpl.getSelectedIndex() >= 0 ? choiceImpl.getSelectedIndex() : focus));
+		if (focus < top) top = focus;
+		if (focus >= top + visible) top = focus - visible + 1;
+		g.setFont(f);
+		for (int i = top; i < n && i < top + visible; i++) {
+			int y = y0 + (i - top) * rh;
+			if (i == focus) {
+				g.setColor(0xFFE6E6E6);
+				g.fillRect(1, y, w - 8, rh - 1);
+				g.setColor(0xFF556D95);
+				g.drawRect(0, y, w - 8, rh - 1);
+			}
+			g.setColor(0xFF000000);
+			int x = 4;
+			if (type != Choice.IMPLICIT) {
+				int cy = y + (rh - 10) / 2;
+				if (type == Choice.MULTIPLE) {
+					g.drawRect(x, cy, 10, 10);
+					if (choiceImpl.isSelected(i)) g.fillRect(x + 3, cy + 3, 5, 5);
+				} else {
+					g.drawArc(x, cy, 10, 10, 0, 360);
+					if (choiceImpl.isSelected(i)) g.fillArc(x + 3, cy + 3, 5, 5, 0, 360);
+				}
+				x += 14;
+			}
+			Image im = choiceImpl.getImage(i);
+			if (im != null) {
+				g.drawImage(im, x, y + 1, Graphics.TOP | Graphics.LEFT);
+				x += im.getWidth() + 3;
+			}
+			Font itemFont = choiceImpl.getFont(i);
+			g.setFont(itemFont != null ? itemFont : f);
+			g.drawString(String.valueOf(choiceImpl.getString(i)), x, y + 2, Graphics.TOP | Graphics.LEFT);
+			g.setFont(f);
+		}
+	}
+
+	public void drawScrollBar(Graphics g) { }
+
+	// ---- IScreenImpl: nothing native to manage ------------------------------------------------------
+	public boolean isSWT() { return false; }
+	public void swtShown() { }
+	public void swtHidden() { }
+	public void swtUpdateSizes() { }
+	public Object getSwtContent() { return null; }
+	public int getWidth() { return Emulator.getEmulator().getScreen().getWidth(); }
+	public int getHeight() { return Emulator.getEmulator().getScreen().getHeight(); }
+}
