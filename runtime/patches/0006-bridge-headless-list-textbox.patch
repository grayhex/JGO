new file mode 100644
index 00000000..0a6f93f2
--- /dev/null
+++ b/src/main/emulator/lcdui/TextBoxHeadless.java
@@ -0,0 +1,112 @@
+package emulator.lcdui;
+
+import emulator.Emulator;
+import javax.microedition.lcdui.Font;
+import javax.microedition.lcdui.Graphics;
+import javax.microedition.lcdui.TextField;
+
+/**
+ * j2me-web: software TextBox for the Bridge (headless) frontend. Holds the text model so MIDlet code
+ * (getString/setString/insert/delete/...) keeps working, and draws the text read-only into the
+ * framebuffer. Typing needs the Bridge "E" event, which KEmulator has not implemented yet.
+ */
+public class TextBoxHeadless implements ITextBoxImpl {
+	private StringBuffer text;
+	private int maxSize;
+	private int constraints;
+	private int caret;
+
+	public TextBoxHeadless(String text, int maxSize, int constraints) {
+		if (maxSize <= 0) throw new IllegalArgumentException("maxSize must be positive");
+		this.maxSize = maxSize;
+		this.constraints = constraints;
+		this.text = new StringBuffer(text == null ? "" : text);
+		if (this.text.length() > maxSize) throw new IllegalArgumentException("text longer than maxSize");
+		caret = this.text.length();
+	}
+
+	public int getCaretPosition() { return caret; }
+	public synchronized String getString() { return text.toString(); }
+
+	public synchronized void setString(String newText) {
+		String s = newText == null ? "" : newText;
+		if (s.length() > maxSize) throw new IllegalArgumentException("text longer than maxSize");
+		text = new StringBuffer(s);
+		caret = s.length();
+	}
+
+	public synchronized int getChars(char[] charData) {
+		if (charData.length < text.length()) throw new ArrayIndexOutOfBoundsException();
+		text.getChars(0, text.length(), charData, 0);
+		return text.length();
+	}
+
+	public synchronized void setChars(char[] charData, int offset, int length) {
+		if (charData == null) { setString(""); return; }
+		setString(new String(charData, offset, length));
+	}
+
+	public synchronized void insert(String s, int position) {
+		if (text.length() + s.length() > maxSize) throw new IllegalArgumentException("maxSize exceeded");
+		text.insert(Math.max(0, Math.min(position, text.length())), s);
+	}
+
+	public synchronized void delete(int offset, int length) {
+		if (offset < 0 || length < 0 || offset + length > text.length()) throw new StringIndexOutOfBoundsException();
+		text.delete(offset, offset + length);
+		caret = Math.min(caret, text.length());
+	}
+
+	public int getMaxSize() { return maxSize; }
+
+	public synchronized int setMaxSize(int newMaxSize) {
+		if (newMaxSize <= 0) throw new IllegalArgumentException();
+		if (text.length() > newMaxSize) text.setLength(newMaxSize);
+		return maxSize = newMaxSize;
+	}
+
+	public synchronized int size() { return text.length(); }
+	public void setConstraints(int newConstraints) { constraints = newConstraints; }
+	public int getConstraints() { return constraints; }
+	public void setInitialInputMode(String inputMode) { }
+	public void defocus() { }
+	public void focusCaret() { }
+
+	public void layout() { }
+
+	public synchronized void paint(Graphics g) {
+		Font f = Font.getDefaultFont();
+		int w = getWidth();
+		int y = f.getHeight() + 6;
+		g.setFont(f);
+		g.setColor(0xFF000000);
+		String s = (constraints & TextField.CONSTRAINT_MASK) == TextField.PASSWORD || (constraints & TextField.PASSWORD) != 0
+				? repeat('*', text.length()) : text.toString();
+		StringBuffer line = new StringBuffer();
+		for (int i = 0; i <= s.length(); i++) {
+			char c = i < s.length() ? s.charAt(i) : '\n';
+			if (c == '\n' || f.stringWidth(line.toString() + c) > w - 8) {
+				g.drawString(line.toString(), 4, y, Graphics.TOP | Graphics.LEFT);
+				y += f.getHeight() + 1;
+				line.setLength(0);
+				if (c != '\n') line.append(c);
+			} else {
+				line.append(c);
+			}
+		}
+	}
+
+	private static String repeat(char c, int n) {
+		StringBuffer sb = new StringBuffer(n);
+		for (int i = 0; i < n; i++) sb.append(c);
+		return sb.toString();
+	}
+
+	public boolean isSWT() { return false; }
+	public void swtShown() { }
+	public void swtHidden() { }
+	public void swtUpdateSizes() { }
+	public Object getSwtContent() { return null; }
+	public int getWidth() { return Emulator.getEmulator().getScreen().getWidth(); }
+	public int getHeight() { return Emulator.getEmulator().getScreen().getHeight(); }
+}
