+	private synchronized void suspend(boolean on) {
+		if (on == suspended) return;
+		suspended = on;
+		EventQueue q = Emulator.getEventQueue();
+		if (on) {
+			q.queue(EventQueue.EVENT_PAUSE);
+			// the event thread handles nothing once paused, so the freeze must come after it handled EVENT_PAUSE;
+			// it ignores the event on screens other than a Canvas, which are then only frozen
+			for (int i = 0; i < 30 && !q.isPaused(); i++) {
+				try {
+					Thread.sleep(10);
+				} catch (InterruptedException e) {
+					break;
+				}
+			}
+			eventsSuspended = q.isPaused();
+			AppSettings.steps = 0;
+		} else {
+			AppSettings.steps = -1;
+			if (eventsSuspended) q.queue(EventQueue.EVENT_RESUME);
+			eventsSuspended = false;
+		}
+	}
