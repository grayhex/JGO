+    private static final class DurableOutput extends FileOutputStream {
+        private final File target, temporary;
+        private boolean done;
+        DurableOutput(File target) throws IOException {
+            this(target, File.createTempFile("rms-", ".pending", target.getParentFile()));
+        }
+        private DurableOutput(File target, File temporary) throws IOException {
+            super(temporary); this.target = target; this.temporary = temporary;
+        }
+        public void close() throws IOException {
+            if (done) return;
+            done = true;
+            try {
+                try { flush(); getFD().sync(); } finally { super.close(); }
+                java.nio.file.Files.move(temporary.toPath(), target.toPath(),
+                    java.nio.file.StandardCopyOption.ATOMIC_MOVE,
+                    java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+                // Linux directory fsync makes the rename durable as well.
+                try (java.nio.channels.FileChannel directory = java.nio.channels.FileChannel.open(target.getParentFile().toPath(), java.nio.file.StandardOpenOption.READ)) {
+                    directory.force(true);
+                } catch (UnsupportedOperationException ignored) { }
+            } finally { temporary.delete(); }
+        }
+    }
