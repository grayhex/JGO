@@ -0,0 +1,26 @@
+package emulator.ui.bridge;
+
+import emulator.ui.IMessage;
+
+import javax.wireless.messaging.Message;
+import java.io.IOException;
+import java.io.InterruptedIOException;
+
+/**
+ * j2me-web: there is no SMS console in the Bridge frontend. IEmulatorFrontend.getMessage() used to return
+ * null, so a game that used javax.wireless.messaging died with a NullPointerException. A phone without
+ * a SIM card reports an IOException on send and never receives anything: do the same.
+ */
+final class BridgeMessage implements IMessage {
+
+	@Override
+	public Message receive(String address) throws IOException, InterruptedIOException {
+		return null;
+	}
+
+	@Override
+	public void send(Message message, String address) throws IOException, InterruptedIOException {
+		System.out.println("[sms] message to " + address + " was not sent: SMS is not available in this player");
+		throw new IOException("SMS is not available");
+	}
+}
