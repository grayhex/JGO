# Copy to .env next to compose.yaml. Only JGO_TOKEN is required.

# Access token for the web UI: at least 16 characters. Generate one:  openssl rand -hex 16
JGO_TOKEN=

# Release to run: latest, or a pinned one such as 0.1.0-beta.1
#JGO_VERSION=latest

# Where the web UI listens on the host. 127.0.0.1 = this machine only (behind a reverse proxy).
#JGO_BIND=0.0.0.0
#JGO_PORT=8080

# Library, saves and settings. A volume name (default) or an absolute folder on the NAS:
#JGO_DATA=/volume1/docker/jgo/data
# With a folder the container must run as that folder's owner (Synology: `id <user>`; UGREEN: `id <user>` over SSH):
#PUID=1026
#PGID=100

# Your collection of .jar/.jad files (mounted read-only at /mnt/jgo-library):
#JGO_LIBRARY=/volume1/games/j2me

# Limits. One emulator needs roughly 0.25-0.5 GB of RAM and a CPU core.
#MAX_SESSIONS=1
#MEM_LIMIT=1536m
#CPUS=2
#SESSION_MAX_MINUTES=120
#SESSION_IDLE_MINUTES=5
#LIBRARY_QUOTA_MB=4096

# Needed only when a reverse proxy gives the UI another address, e.g. https://jgo.example.com
#ALLOWED_ORIGINS=

# Optional: MobyGames covers and descriptions (can also be entered in Settings)
#MOBYGAMES_API_KEY=
