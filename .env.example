# Copy to .env (docker compose reads it). All values are optional.
PORT=8080
# Required before exposing beyond localhost (>= 16 chars). Empty = unauthenticated, loopback only.
AUTH_TOKEN=
MAX_SESSIONS=1
SESSION_MAX_MINUTES=120
# raw (best on localhost) | deflate (~55x smaller on the wire; default in compose)
FRAME_ENCODING=deflate
# Extra browser origins allowed to call the API (reverse proxies / dev servers), space separated
ALLOWED_ORIGINS=
MEM_LIMIT=1536m
CPUS=2
# Mirror for base images if Docker Hub rate-limits you
BASE_REGISTRY=docker.io/library
