# Copy to .env next to compose.yaml. Nothing is required: without a token MGO generates one on first start (see the app container log).
# MGO deployment settings.

# Access token for the web UI: at least 16 characters. Generate one:  openssl rand -hex 16
MGO_TOKEN=

# Release to run: latest, or a pinned one such as 0.1.0-beta.1
#MGO_VERSION=latest

# Where the web UI listens on the host. 127.0.0.1 = this machine only (behind a reverse proxy).
#MGO_BIND=0.0.0.0
#MGO_PORT=8080

# Library, saves and settings. A volume name (default) or an absolute folder on the NAS:
#MGO_DATA=/volume1/docker/mgo/data
# With a folder the container must run as that folder's owner (Synology: `id <user>`; UGREEN: `id <user>` over SSH):
#PUID=1026
#PGID=100

# Your collection of .jar/.jad files (mounted read-only at /mnt/mgo-library):
#MGO_LIBRARY=/volume1/games/j2me

# Limits. One emulator needs roughly 0.25-0.5 GB of RAM and a CPU core.
#MAX_SESSIONS=1
#MEM_LIMIT=1536m
#CPUS=2
#SESSION_MAX_MINUTES=120
#SESSION_IDLE_MINUTES=5
#LIBRARY_QUOTA_MB=4096

# Symbian / N-Gage service (mgo-symbian, part of compose.yaml). The app and the service share a secret automatically.
#MGO_SYMBIAN_VERSION=edge
# Folder on the host with firmware archives that are too big for the browser (Settings -> Symbian -> "Firmware from a folder"):
#SYMBIAN_INBOX=./symbian-inbox
#SYMBIAN_CPUS=2
#SYMBIAN_MEMORY=3g

# Needed only when a reverse proxy gives the UI another address, e.g. https://mgo.example.com
#ALLOWED_ORIGINS=

# Optional: MobyGames covers and descriptions (can also be entered in Settings)
#MOBYGAMES_API_KEY=

# HTTPS, persistent certificate and separate read-only platform libraries
#MGO_HTTPS_PORT=8443
#MGO_TLS_SAN=DNS:mgo.home,IP:192.168.1.50
#MGO_TLS_CERTS=/volume1/docker/mgo/certs
#MGO_JAVA_LIBRARY=/volume1/games/java
#MGO_NGAGE_LIBRARY=/volume1/games/ngage
#MGO_SIS_LIBRARY=/volume1/games/sis
