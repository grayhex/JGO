# JGO configuration. Read by jgo.service (systemd EnvironmentFile), so no "export" and no quotes around values.
# After editing: systemctl restart jgo

# --- network -------------------------------------------------------------------------------------
# Listen on every interface of the container. The server refuses to start like this without AUTH_TOKEN.
HOST=0.0.0.0
PORT=8080
# Access token for the web UI and the API (>= 16 characters). Generated at install time; show it with `jgo token`.
AUTH_TOKEN=
# Extra browser origins allowed to call the API (a reverse proxy in front of JGO), space separated.
ALLOWED_ORIGINS=

# --- paths (set by the installer, do not change unless you move the data) ----------------------------
DATA_DIR=/var/lib/jgo
KEM_DIR=/opt/jgo/kemulator
ADAPTER_BIN=/opt/jgo/bin/kem-adapter
WEB_DIR=/opt/jgo/app/apps/web/dist
RUN_DIR=/run/jgo/sessions
HOME=/run/jgo/home
TMPDIR=/tmp

# --- game library -------------------------------------------------------------------------------------
# Folders a library directory may be chosen from in Settings (space separated, absolute). The web UI and the API can only
# read inside these (plus <DATA_DIR>/import); everything else on the container's disk stays out of reach.
# Unset = /mnt/jgo-library /srv/jgo-library. Share a host folder with: tools/proxmox/jgo-library-mount.sh <CTID> /host/games
LIBRARY_ROOTS=/mnt/jgo-library /srv/jgo-library
# Optional MobyGames API key (normally entered in Settings and stored in /var/lib/jgo/secrets.json instead)
MOBYGAMES_API_KEY=

# --- limits --------------------------------------------------------------------------------------
MAX_SESSIONS=1
SESSION_MAX_MINUTES=120
SESSION_IDLE_MINUTES=5
MAX_UPLOAD_MB=32
LIBRARY_QUOTA_MB=4096
FRAME_ENCODING=deflate
# CPU-seconds budget per emulator process (0 = unlimited)
KEM_CPU_SECONDS=0

# --- emulator ------------------------------------------------------------------------------------
KEM_DISPLAY=:99
LIBGL_ALWAYS_SOFTWARE=1
KEM_JVM_ARGS=-Xmx768m -Xss1m -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=128m -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/tmp
# Games run in their own network namespace (no network at all). `jgo network allow` removes the wrapper.
KEM_LAUNCH_WRAPPER=unshare --user --map-current-user --net --
LOG_LEVEL=info
