#!/usr/bin/env bash
# mgo - manage a native MGO installation (Proxmox VE LXC, Debian 13, systemd).
#
#   mgo status | update | backup | restore | logs | doctor | token | network | rollback | version
#
# Layout:  /opt/mgo (release, root-owned)   /var/lib/mgo (games, SQLite, RMS)   /etc/mgo (configuration)
# Every path and the release source can be overridden through the environment; the tests use that.
set -Eeuo pipefail

MGO_HOME="${MGO_HOME:-/opt/mgo}"
MGO_DATA="${MGO_DATA:-/var/lib/mgo}"
MGO_CONF="${MGO_CONF:-/etc/mgo}"
MGO_ENV="${MGO_ENV:-$MGO_CONF/mgo.env}"
MGO_BACKUPS="${MGO_BACKUPS:-/var/backups/mgo}"
MGO_CACHE="${MGO_CACHE:-/var/cache/mgo}"
MGO_REPO="${MGO_REPO:-grayhex/MGO}"
MGO_API="${MGO_API:-https://api.github.com}"
MGO_UNITS="${MGO_UNITS:-/etc/systemd/system}"
MGO_STAMP="${MGO_STAMP:-/root/.mgo}"
MGO_USER="${MGO_USER:-mgo}"
MGO_HEALTH_WAIT="${MGO_HEALTH_WAIT:-60}"
MGO_BACKUP_KEEP="${MGO_BACKUP_KEEP:-7}"
LOCK=/run/mgo-admin.lock

if [[ -t 1 ]]; then
  R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' B=$'\e[1m' N=$'\e[0m'
else
  R='' G='' Y='' B='' N=''
fi
info() { printf '%s\n' "$*"; }
ok() { printf '%s✔%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }
die() {
  printf '%s✘%s %s\n' "$R" "$N" "$*" >&2
  exit 1
}

need_root() { [[ $EUID -eq 0 ]] || die "run as root (inside the container: pct enter <CTID>)"; }
have() { command -v "$1" >/dev/null 2>&1; }

version() { tr -d '[:space:]' <"$MGO_HOME/VERSION" 2>/dev/null || echo unknown; }
strip_v() { printf '%s' "${1#v}"; }

env_get() { [[ -f $MGO_ENV ]] && sed -n "s/^$1=//p" "$MGO_ENV" | head -n1 || true; }
env_set() { # keeps owner and mode of the file (rewrites in place)
  local key=$1 val=$2 tmp
  tmp=$(mktemp)
  if grep -q "^$key=" "$MGO_ENV" 2>/dev/null; then
    awk -v k="$key" -v v="$val" 'BEGIN{FS=OFS="="} $1==k{print k"="v; next} {print}' "$MGO_ENV" >"$tmp"
  else
    cat "$MGO_ENV" >"$tmp"
    printf '%s=%s\n' "$key" "$val" >>"$tmp"
  fi
  cat "$tmp" >"$MGO_ENV"
  rm -f "$tmp"
}

port() { echo "${MGO_PORT:-$(env_get PORT)}" | sed 's/^$/8080/'; }
health_json() { curl -fsS --max-time 3 "http://127.0.0.1:$(port)/api/health" 2>/dev/null; }
ip_addr() { hostname -I 2>/dev/null | awk '{print $1}'; }

svc_stop() {
  info "Requesting safe game shutdown; unresponsive games may be forcibly closed. Only game-written RMS is preserved." >&2
  systemctl stop mgo || die "MGO did not stop; refusing to modify the installation or take an inconsistent backup"
  systemctl stop mgo-xvfb
}
svc_start() { systemctl start mgo; }
svc_active() { systemctl is-active --quiet "$1"; }

wait_healthy() { # wait_healthy <expected version>
  local want=$1 i json
  for ((i = 0; i < MGO_HEALTH_WAIT; i++)); do
    if svc_active mgo && json=$(health_json) && [[ $(jq -r '.ok' <<<"$json") == true ]] &&
      [[ -z $want || $(jq -r '.version' <<<"$json") == "$want" ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

lock() {
  exec 9>"$LOCK"
  flock -n 9 || die "another mgo update/backup/restore is running"
}

# --------------------------------------------------------------------------------------- status
cmd_status() {
  local json='' as_json=0
  [[ ${1:-} == --json ]] && as_json=1
  json=$(health_json || true)
  if ((as_json)); then
    jq -n --arg v "$(version)" --arg ip "$(ip_addr)" --argjson port "$(port)" \
      --arg mgo "$(systemctl is-active mgo 2>/dev/null || true)" --arg xvfb "$(systemctl is-active mgo-xvfb 2>/dev/null || true)" \
      --argjson health "${json:-null}" '{version:$v, ip:$ip, port:$port, services:{mgo:$mgo, xvfb:$xvfb}, health:$health}'
    return 0
  fi
  local j=${json:-'{}'}
  info "${B}MGO $(version)${N}  (KEmulator $(jq -r '.kemulator.commit // "?"' <<<"$j" | cut -c1-9))"
  printf '  services : mgo %s, mgo-xvfb %s\n' "$(systemctl is-active mgo 2>/dev/null || true)" "$(systemctl is-active mgo-xvfb 2>/dev/null || true)"
  printf '  url      : http://%s:%s\n' "$(ip_addr)" "$(port)"
  if [[ -n $json ]]; then
    printf '  health   : %s, sessions %s/%s, auth %s, java %s\n' "$(jq -r 'if .ok then "ok" else "NOT OK" end' <<<"$json")" \
      "$(jq -r '.activeSessions' <<<"$json")" "$(jq -r '.maxSessions' <<<"$json")" "$(jq -r '.auth' <<<"$json")" "$(jq -r '.java.version // "?"' <<<"$json")"
  else
    printf '  health   : %sunreachable%s (see: mgo logs, mgo doctor)\n' "$R" "$N"
  fi
  printf '  data     : %s, %s games\n' "$(du -sh "$MGO_DATA" 2>/dev/null | cut -f1)" "$(find "$MGO_DATA/games" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
  local last
  last=$(find "$MGO_BACKUPS" -maxdepth 1 -name 'mgo-*.tar.gz' -printf '%T@ %f\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
  printf '  backup   : %s\n' "${last:-none yet (mgo backup)}"
}

# --------------------------------------------------------------------------------------- logs
cmd_logs() {
  case "${1:-}" in
  -h | --help) info "usage: mgo logs [-f] [-n LINES] [--since 1h]   (journalctl for mgo and mgo-xvfb)" ;;
  *) exec journalctl -u mgo -u mgo-xvfb --no-pager "$@" ;;
  esac
}

# --------------------------------------------------------------------------------------- token
cmd_token() {
  need_root
  if [[ ${1:-} == --rotate ]]; then
    local t
    t=$(head -c 256 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32)
    env_set AUTH_TOKEN "$t"
    systemctl restart mgo
    ok "new access token (sessions of the old one are logged out):"
  fi
  env_get AUTH_TOKEN
}

# --------------------------------------------------------------------------------------- network
cmd_network() {
  need_root
  local wrapper='unshare --user --map-current-user --net --'
  case "${1:-status}" in
  deny) env_set KEM_LAUNCH_WRAPPER "$wrapper" ;;
  allow) env_set KEM_LAUNCH_WRAPPER "" ;;
  status) ;;
  *) die "usage: mgo network [deny|allow|status]" ;;
  esac
  if [[ ${1:-status} != status ]]; then systemctl restart mgo; fi
  if [[ -n $(env_get KEM_LAUNCH_WRAPPER) ]]; then
    ok "games run without network access (own network namespace)"
  else
    warn "games can reach the network the container can reach (LAN included); use the Proxmox firewall for the container, see docs/PROXMOX.md"
  fi
}

# --------------------------------------------------------------------------------------- backup
backup_name() { printf 'mgo-%s-%s-%s%s.tar.gz' "$(hostname -s)" "$(version)" "$(date -u +%Y%m%dT%H%M%SZ)" "${1:+-$1}"; }

# mgo backup [--out DIR_OR_FILE] [--label L] [--no-games] [--stop]
cmd_backup() {
  need_root
  local out="$MGO_BACKUPS" label='' games=1 stop=0
  while (($#)); do
    case $1 in
    --out) out=$2; shift ;;
    --label) label=$2; shift ;;
    --no-games) games=0 ;;
    --stop) stop=1 ;;
    -h | --help) info "usage: mgo backup [--out DIR|FILE] [--label NAME] [--no-games] [--stop]"; return 0 ;;
    *) die "unknown option: $1" ;;
    esac
    shift
  done
  lock
  do_backup "$out" "$label" "$games" "$stop"
}

do_backup() { # do_backup <out> <label> <games 0|1> <stop 0|1>; prints the archive path last
  local out=$1 label=$2 games=$3 stop=$4 file stage was_active=0
  if [[ $out == *.tar.gz ]]; then
    file=$out
    mkdir -p "$(dirname "$file")"
  else
    mkdir -p "$out"
    file="$out/$(backup_name "$label")"
  fi
  [[ -d $MGO_DATA ]] || die "no data directory at $MGO_DATA"
  local need have_kb
  need=$(du -sk "$MGO_DATA" | cut -f1)
  have_kb=$(df -Pk "$(dirname "$file")" | awk 'NR==2{print $4}')
  ((have_kb > need + 20480)) || die "not enough free space in $(dirname "$file") for the backup (need ~$((need / 1024 + 20)) MB)"

  if ((stop)) && svc_active mgo; then
    was_active=1
    svc_stop
  fi
  stage=$(mktemp -d "$(dirname "$file")/.stage.XXXXXX")
  # shellcheck disable=SC2064
  trap "rm -rf '$stage'" RETURN
  mkdir -p "$stage/data" "$stage/etc"
  if [[ -f $MGO_DATA/library.sqlite ]]; then
    # a consistent snapshot even while the server is writing. It runs as the service user (so no root-owned
    # -wal/-shm files appear) and writes into a directory that user owns; root moves the result into the archive.
    local snap
    snap=$(mktemp -d "$MGO_DATA/.snapshot.XXXXXX")
    chown "$MGO_USER:$MGO_USER" "$snap"
    if runuser -u "$MGO_USER" -- node -e '
      const { DatabaseSync } = require("node:sqlite");
      const db = new DatabaseSync(process.argv[1]);
      db.exec("VACUUM INTO \x27" + process.argv[2].replace(/\x27/g, "\x27\x27") + "\x27");
      db.close();' "$MGO_DATA/library.sqlite" "$snap/library.sqlite" 2>/dev/null; then
      mv "$snap/library.sqlite" "$stage/data/library.sqlite"
    else
      warn "online snapshot of the library failed, copying the files"
      cp -a "$MGO_DATA"/library.sqlite* "$stage/data/"
    fi
    rm -rf "$snap"
  fi
  [[ -d $MGO_DATA/saves ]] && cp -a "$MGO_DATA/saves" "$stage/data/saves"
  # settings from the web UI, the MobyGames key (secrets.json, so keep backups private) and downloaded covers/screenshots
  local f
  for f in settings.json secrets.json; do
    [[ -f $MGO_DATA/$f ]] && cp -a "$MGO_DATA/$f" "$stage/data/$f"
  done
  [[ -d $MGO_DATA/metadata ]] && cp -a "$MGO_DATA/metadata" "$stage/data/metadata"
  if ((games)) && [[ -d $MGO_DATA/games ]]; then cp -a "$MGO_DATA/games" "$stage/data/games"; fi
  [[ -f $MGO_ENV ]] && cp -a "$MGO_ENV" "$stage/etc/mgo.env"
  ((was_active)) && svc_start

  jq -n --arg v "$(version)" --arg h "$(hostname -s)" --arg d "$(date -u +%FT%TZ)" --argjson g "$games" \
    --arg kem "$(cat "$MGO_HOME/kemulator/KEM_COMMIT" 2>/dev/null || true)" --arg label "$label" \
    '{format:1, mgo:$v, kemulator:$kem, host:$h, created:$d, games:($g==1), label:$label}' >"$stage/meta.json"
  (cd "$stage" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum >SHA256SUMS)
  tar -C "$stage" -czf "$file.part" . && chmod 600 "$file.part" && mv "$file.part" "$file"
  ok "backup: $file ($(du -h "$file" | cut -f1))"
  if [[ $file == "$MGO_BACKUPS"/* && $MGO_BACKUP_KEEP -gt 0 ]]; then # keep the newest N
    find "$MGO_BACKUPS" -maxdepth 1 -name 'mgo-*.tar.gz' -printf '%T@ %p\n' | sort -rn | tail -n +$((MGO_BACKUP_KEEP + 1)) | cut -d' ' -f2- | xargs -r rm -f
  fi
  BACKUP_FILE=$file
}

# --------------------------------------------------------------------------------------- restore
# mgo restore FILE [--yes] [--only db,saves,games,config] [--with-config] [--no-safety]
cmd_restore() {
  need_root
  local file='' yes=0 only='db,saves,games,settings,metadata' safety=1
  while (($#)); do
    case $1 in
    --yes | -y) yes=1 ;;
    --only) only=$2; shift ;;
    --with-config) only="$only,config" ;;
    --no-safety) safety=0 ;;
    -h | --help)
      info "usage: mgo restore FILE.tar.gz [--yes] [--with-config] [--only db,saves,games,settings,metadata,config] [--no-safety]"
      return 0
      ;;
    -*) die "unknown option: $1" ;;
    *) file=$1 ;;
    esac
    shift
  done
  [[ -f $file ]] || die "backup file not found: ${file:-<none>}"
  lock
  do_restore "$file" "$yes" "$only" "$safety"
}

do_restore() { # do_restore <file> <yes> <only> <safety>
  local file=$1 yes=$2 only=$3 safety=$4 stage meta
  stage=$(mktemp -d "$MGO_CACHE.restore.XXXXXX")
  # shellcheck disable=SC2064
  trap "rm -rf '$stage'" RETURN
  tar -tzf "$file" | awk '$0 ~ /(^|\/)\.\.(\/|$)/ || $0 ~ /^\//{bad=1} END{exit bad}' || die "unsafe paths in the archive"
  tar --no-same-owner --no-same-permissions -xzf "$file" -C "$stage"
  (cd "$stage" && sha256sum -c --quiet SHA256SUMS) || die "checksum mismatch: the backup is damaged"
  meta=$(cat "$stage/meta.json")
  info "backup of MGO $(jq -r .mgo <<<"$meta") from $(jq -r .host <<<"$meta") ($(jq -r .created <<<"$meta")), games included: $(jq -r .games <<<"$meta")"
  if [[ $(jq -r .format <<<"$meta") != 1 ]]; then die "unsupported backup format"; fi
  if ((!yes)); then
    [[ -t 0 ]] || die "refusing to overwrite data without --yes"
    read -r -p "Replace the data in $MGO_DATA (${only}) with this backup? [y/N] " a
    [[ $a == y || $a == Y ]] || die "cancelled"
  fi
  local safe=''
  if ((safety)) && [[ -d $MGO_DATA ]]; then
    do_backup "$MGO_BACKUPS" pre-restore 1 1 >/dev/null
    safe=$BACKUP_FILE
    info "safety copy of the current data: $safe"
  fi
  svc_stop
  local part
  for part in ${only//,/ }; do
    case $part in
    db)
      if [[ -f $stage/data/library.sqlite ]]; then
        rm -f "$MGO_DATA"/library.sqlite*
        install -o "$MGO_USER" -g "$MGO_USER" -m 600 "$stage/data/library.sqlite" "$MGO_DATA/library.sqlite"
      fi
      ;;
    saves) [[ -d $stage/data/saves ]] && { rm -rf "$MGO_DATA/saves"; cp -a "$stage/data/saves" "$MGO_DATA/saves"; } ;;
    games) [[ -d $stage/data/games ]] && { rm -rf "$MGO_DATA/games"; cp -a "$stage/data/games" "$MGO_DATA/games"; } ;;
    settings)
      local f
      for f in settings.json secrets.json; do
        [[ -f $stage/data/$f ]] && install -o "$MGO_USER" -g "$MGO_USER" -m 600 "$stage/data/$f" "$MGO_DATA/$f"
      done
      ;;
    metadata) [[ -d $stage/data/metadata ]] && { rm -rf "$MGO_DATA/metadata"; cp -a "$stage/data/metadata" "$MGO_DATA/metadata"; } ;;
    config) [[ -f $stage/etc/mgo.env ]] && { cp -a "$MGO_ENV" "$MGO_ENV.before-restore" 2>/dev/null || true; cat "$stage/etc/mgo.env" >"$MGO_ENV"; } ;;
    *) die "unknown part: $part" ;;
    esac
  done
  chown -R "$MGO_USER:$MGO_USER" "$MGO_DATA"
  chmod 700 "$MGO_DATA"
  svc_start
  if wait_healthy ''; then
    ok "restored ($only); MGO is healthy"
  else
    if [[ -n $safe ]]; then
      warn "MGO did not become healthy after the restore; putting the previous data back"
      do_restore "$safe" 1 'db,saves,games,settings,metadata,config' 0
    fi
    die "restore failed (see: mgo logs)"
  fi
}

# --------------------------------------------------------------------------------------- update
gh() {
  curl -fsSL --retry 3 --connect-timeout 10 -H 'Accept: application/vnd.github+json' \
    ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} "$@"
}

# resolve the release: sets REL_TAG REL_VERSION REL_URL REL_SUMS_URL
resolve_release() {
  local want=${1:-latest} json url
  if [[ $want == latest ]]; then url="$MGO_API/repos/$MGO_REPO/releases/latest"; else url="$MGO_API/repos/$MGO_REPO/releases/tags/$want"; fi
  json=$(gh "$url") || die "cannot read the release ($url)"
  REL_TAG=$(jq -er .tag_name <<<"$json") || die "malformed release data"
  REL_VERSION=$(strip_v "$REL_TAG")
  [[ $REL_VERSION =~ ^[0-9A-Za-z._+-]+$ ]] || die "refusing the odd version string: $REL_VERSION"
  REL_URL=$(jq -r '.assets[] | select(.name | test("^mgo-.*-linux-amd64\\.tar\\.gz$")) | .browser_download_url' <<<"$json" | head -n1)
  REL_SUMS_URL=$(jq -r '.assets[] | select(.name == "SHA256SUMS") | .browser_download_url' <<<"$json" | head -n1)
  [[ -n $REL_URL && -n $REL_SUMS_URL ]] || die "release $REL_TAG has no mgo-*-linux-amd64.tar.gz + SHA256SUMS"
}

# Semantic-version order: 0.1.0-beta.1 < 0.1.0-beta.2 < 0.1.0 < 0.1.1 (plain `sort -V` puts 0.1.0-beta.1 after 0.1.0)
version_gt() {
  local a=$1 b=$2 ca=${1%%-*} cb=${2%%-*}
  [[ $a != "$b" ]] || return 1
  if [[ $ca != "$cb" ]]; then [[ $(printf '%s\n%s\n' "$ca" "$cb" | sort -V | tail -n1) == "$ca" ]]; return; fi
  [[ $a != *-* ]] && return 0
  [[ $b != *-* ]] && return 1
  [[ $(printf '%s\n%s\n' "${a#*-}" "${b#*-}" | sort -V | tail -n1) == "${a#*-}" ]]
}

# every symlink must stay inside the tree, every file must be a regular file, dir or link
verify_tree() {
  local root=$1 l t
  while IFS= read -r l; do
    t=$(realpath -m -- "$l")
    [[ $t == "$root"/* ]] || die "release contains a link that points outside of it: ${l#"$root"/}"
  done < <(find "$root" -type l)
  [[ -z $(find "$root" ! -type f ! -type d ! -type l -print -quit) ]] || die "release contains special files"
  for f in VERSION bin/mgo bin/kem-adapter kemulator/KEmulator.jar app/apps/api/dist/server.js app/apps/web/dist/index.html share/systemd/mgo.service share/mgo.env.example; do
    [[ -e $root/$f ]] || die "release is incomplete: $f is missing"
  done
}

archive_version() { # VERSION at the top of the tarball (flat, or inside one top-level directory)
  local member
  member=$(tar -tzf "$1" | grep -xE '(\./)?([^/]+/)?VERSION' | head -n1)
  [[ -n $member ]] && tar -xzOf "$1" "$member" | tr -d '[:space:]'
}

# mgo update [--check] [--to TAG] [--yes] [--from-file ARCHIVE --sums FILE]
cmd_update() {
  need_root
  local check=0 to=latest yes=0 force=0 archive='' sums=''
  while (($#)); do
    case $1 in
    --check) check=1 ;;
    --to) to=$2; shift ;;
    --yes | -y) yes=1 ;;
    --force) force=1 ;;
    --from-file) archive=$2; shift ;; # offline update (and tests): a downloaded release tarball
    --sums) sums=$2; shift ;;
    -h | --help)
      info "usage: mgo update [--check] [--to vX.Y.Z] [--yes] [--force] [--from-file TARBALL --sums SHA256SUMS]"
      return 0
      ;;
    *) die "unknown option: $1" ;;
    esac
    shift
  done
  local cur
  cur=$(version)
  if [[ -z $archive ]]; then
    resolve_release "$to"
    info "installed: $cur   release: $REL_VERSION"
    if ((check)); then
      if version_gt "$REL_VERSION" "$cur"; then
        info "update available: $REL_VERSION"
        return 10
      fi
      ok "up to date"
      return 0
    fi
    if [[ $REL_VERSION == "$cur" && $force == 0 ]]; then
      ok "already on $cur"
      return 0
    fi
    if [[ $to == latest ]] && ! version_gt "$REL_VERSION" "$cur" && ((!force)); then
      ok "the newest release ($REL_VERSION) is not newer than $cur; use --to to pick a version"
      return 0
    fi
  else
    [[ -f $archive && -f $sums ]] || die "--from-file needs --sums"
    REL_VERSION=$(archive_version "$archive")
    [[ -n $REL_VERSION ]] || die "cannot read VERSION from $archive"
  fi
  if ((!yes)) && [[ -t 0 ]]; then
    read -r -p "Update MGO $cur -> $REL_VERSION? A backup is made first. [Y/n] " a
    [[ ${a:-y} == y || ${a:-y} == Y ]] || die "cancelled"
  fi
  lock

  # 1. download + verify -------------------------------------------------------------------
  local work="$MGO_CACHE/$REL_VERSION" tarball
  rm -rf "$work"
  mkdir -p "$work"
  chmod 700 "$MGO_CACHE" "$work"
  if [[ -z $archive ]]; then
    info "downloading $REL_TAG"
    curl -fSL --retry 3 --connect-timeout 10 -o "$work/${REL_URL##*/}" "$REL_URL"
    curl -fsSL --retry 3 --connect-timeout 10 -o "$work/SHA256SUMS" "$REL_SUMS_URL"
    tarball="$work/${REL_URL##*/}"
  else
    cp -- "$archive" "$work/${archive##*/}"
    cp -- "$sums" "$work/SHA256SUMS"
    tarball="$work/${archive##*/}"
  fi
  (cd "$work" && grep -F -- " ${tarball##*/}" SHA256SUMS | sha256sum -c --quiet -) || die "SHA-256 of the download does not match SHA256SUMS; nothing was changed"
  tar -tzf "$tarball" | awk '$0 ~ /(^|\/)\.\.(\/|$)/ || $0 ~ /^\//{bad=1} END{exit bad}' || die "unsafe paths in the release archive; nothing was changed"
  local free_kb
  free_kb=$(df -Pk "$(dirname "$MGO_HOME")" | awk 'NR==2{print $4}')
  ((free_kb > 1024 * 1024)) || die "less than 1 GB free next to $MGO_HOME; nothing was changed"

  # 2. stage the new tree beside the old one -------------------------------------------------
  local new="$MGO_HOME.new" prev="$MGO_HOME.prev"
  rm -rf "$new"
  mkdir -p "$new"
  tar --no-same-owner -xzf "$tarball" -C "$new"
  if [[ $(find "$new" -mindepth 1 -maxdepth 1 | wc -l) -eq 1 && -d $(find "$new" -mindepth 1 -maxdepth 1) ]]; then
    local inner
    inner=$(find "$new" -mindepth 1 -maxdepth 1)
    mv "$inner"/* "$new"/ && rmdir "$inner"
  fi
  verify_tree "$new"
  [[ $(tr -d '[:space:]' <"$new/VERSION") == "$REL_VERSION" ]] || die "VERSION inside the archive does not match $REL_VERSION"
  chown -R root:root "$new"
  chmod -R go-w "$new"
  [[ -x $new/bin/kem-adapter && -x $new/bin/mgo ]] || die "release binaries are not executable"

  # 3. backup, then swap -------------------------------------------------------------------
  info "backing up before the update"
  do_backup "$MGO_BACKUPS" "pre-update-$cur" 1 1 >/dev/null
  local snap=$BACKUP_FILE
  ok "snapshot: $snap"
  svc_stop
  rm -rf "$prev"
  mv "$MGO_HOME" "$prev"
  mv "$new" "$MGO_HOME"
  cp -a "$MGO_ENV" "$MGO_ENV.prev" 2>/dev/null || true
  install_units "$MGO_HOME/share/systemd"
  merge_env "$MGO_HOME/share/mgo.env.example"
  systemctl daemon-reload
  systemctl enable mgo mgo-xvfb >/dev/null 2>&1 || true

  # 4. start + health check, roll back if it fails ------------------------------------------
  svc_start || true
  if wait_healthy "$REL_VERSION"; then
    echo "$REL_VERSION" >"$MGO_STAMP"
    ok "updated $cur -> $REL_VERSION (previous release kept in $prev, snapshot in $snap)"
    rm -rf "${MGO_CACHE:?}/$REL_VERSION"
    return 0
  fi
  warn "MGO $REL_VERSION did not become healthy within ${MGO_HEALTH_WAIT}s: rolling back to $cur"
  journalctl -u mgo -n 15 --no-pager 2>/dev/null | sed 's/^/    /' >&2 || true
  rollback_to_prev "$cur" "$snap"
  die "update to $REL_VERSION failed; $cur is running again (data restored from $snap)"
}

install_units() { # copy the release's unit files; drop-ins in mgo.service.d/ are left alone
  local src=$1 u
  for u in mgo.service mgo-xvfb.service; do
    install -m 644 "$src/$u" "$MGO_UNITS/$u"
  done
}

merge_env() { # add keys that a new release introduced, never touch existing values
  local example=$1 key line
  while IFS= read -r line; do
    [[ $line =~ ^([A-Z_][A-Z0-9_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    grep -q "^$key=" "$MGO_ENV" || printf '%s\n' "$line" >>"$MGO_ENV"
  done <"$example"
}

rollback_to_prev() { # rollback_to_prev <version> <snapshot>
  local cur=$1 snap=${2:-} prev="$MGO_HOME.prev"
  [[ -d $prev ]] || die "no previous release at $prev"
  svc_stop
  rm -rf "$MGO_HOME.failed"
  mv "$MGO_HOME" "$MGO_HOME.failed"
  mv "$prev" "$MGO_HOME"
  [[ -f $MGO_ENV.prev ]] && cat "$MGO_ENV.prev" >"$MGO_ENV"
  install_units "$MGO_HOME/share/systemd"
  systemctl daemon-reload
  if [[ -n $snap && -f $snap ]]; then
    # the failed release may have migrated the database: put back the state from before the update
    (do_restore "$snap" 1 'db,saves' 0) || true
  else
    svc_start || true
  fi
  if wait_healthy "$cur"; then
    echo "$cur" >"$MGO_STAMP"
    ok "rolled back to $cur"
    rm -rf "$MGO_HOME.failed"
  else
    warn "the previous release did not come up either; the failed tree is kept in $MGO_HOME.failed"
  fi
}

cmd_rollback() {
  need_root
  lock
  [[ -d $MGO_HOME.prev ]] || die "nothing to roll back to ($MGO_HOME.prev does not exist)"
  local from to
  from=$(version)
  to=$(tr -d '[:space:]' <"$MGO_HOME.prev/VERSION")
  info "rolling back $from -> $to"
  rollback_to_prev "$to" ""
}

# --------------------------------------------------------------------------------------- library
LIB_DEFAULT_ROOTS='/mnt/mgo-library /srv/mgo-library'

library_roots() {
  local r
  r=$(env_get LIBRARY_ROOTS)
  [[ -n $r ]] && echo "$r" || echo "$LIB_DEFAULT_ROOTS"
}

# mgo library [status]: which folders MGO may import games from, and whether it can read them
cmd_library() {
  case ${1:-status} in
  status) ;;
  -h | --help)
    info "usage: mgo library [status]   (share a host folder: tools/proxmox/mgo-library-mount.sh on the Proxmox host; choose it in Settings > Game library)"
    return 0
    ;;
  *) die "usage: mgo library [status]" ;;
  esac
  local root n any=0 chosen
  chosen=$(jq -r '.settings.libraryPath // empty' "$MGO_DATA/settings.json" 2>/dev/null || true)
  for root in $(library_roots) "$MGO_DATA/import"; do
    if [[ -d $root ]]; then
      any=1
      if runuser -u "$MGO_USER" -- test -r "$root" -a -x "$root" 2>/dev/null; then
        n=$(find "$root" -type f \( -iname '*.jar' \) 2>/dev/null | wc -l)
        ok "$root: readable by $MGO_USER, $n JAR file(s)$(mountpoint -q "$root" 2>/dev/null && printf ', mounted from the host')"
        runuser -u "$MGO_USER" -- test -w "$root" 2>/dev/null && warn "$root is writable; MGO never writes there, a read-only mount (ro=1) is safer"
      else
        warn "$root exists but $MGO_USER cannot read it (unprivileged container: the host files must be readable by 'others', see docs/PROXMOX.md)"
      fi
    else
      info "  $root: not present"
    fi
  done
  ((any)) || info "No library folder is connected. On the Proxmox host: tools/proxmox/mgo-library-mount.sh <CTID> /path/to/games"
  [[ -n $chosen ]] && info "selected in Settings: $chosen" || info "selected in Settings: none (uploads only)"
}

# --------------------------------------------------------------------------------------- doctor
FAILS=0 WARNS=0
pass() { printf '  %s✔%s %s\n' "$G" "$N" "$*"; }
bad() { printf '  %s✘%s %s\n' "$R" "$N" "$*"; FAILS=$((FAILS + 1)); }
meh() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; WARNS=$((WARNS + 1)); }

cmd_doctor() {
  local online=0
  [[ ${1:-} == --online ]] && online=1
  info "${B}MGO doctor${N} ($(version))"
  info "system"
  . /etc/os-release 2>/dev/null || true
  [[ ${VERSION_ID:-} == 13 && ${ID:-} == debian ]] && pass "Debian 13" || meh "Debian 13 is the tested platform (found: ${PRETTY_NAME:-unknown})"
  [[ $(uname -m) == x86_64 ]] && pass "x86_64" || bad "the release is built for x86_64 only"
  local nv
  nv=$(node -v 2>/dev/null | tr -d v)
  [[ -n $nv && ${nv%%.*} -ge 22 ]] && pass "Node.js $nv" || bad "Node.js >= 22 is required (found: ${nv:-none})"
  java -version 2>&1 | grep -q 'version "21' && pass "OpenJDK 21" || bad "OpenJDK 21 is required"
  have Xvfb && pass "Xvfb" || bad "Xvfb is missing"
  compgen -G '/usr/lib/x86_64-linux-gnu/dri/swrast_dri.so' >/dev/null && pass "Mesa software renderer (llvmpipe) for M3G" || bad "Mesa swrast driver is missing (libgl1-mesa-dri)"
  have jq && have curl && pass "curl, jq" || bad "curl and jq are required"
  local free_pct
  free_pct=$(df -P "$MGO_DATA" 2>/dev/null | awk 'NR==2{gsub("%","",$5); print 100-$5}')
  [[ -z $free_pct || $free_pct -ge 10 ]] && pass "disk: ${free_pct:-?}% free" || meh "disk is nearly full (${free_pct}% free)"

  info "installation"
  id "$MGO_USER" >/dev/null 2>&1 && pass "user $MGO_USER exists" || bad "user $MGO_USER is missing"
  [[ $(getent passwd "$MGO_USER" | cut -d: -f7) == */nologin || $(getent passwd "$MGO_USER" | cut -d: -f7) == */false ]] && pass "$MGO_USER has no login shell" || meh "$MGO_USER has a login shell"
  [[ -f $MGO_HOME/VERSION ]] && pass "release $(version) in $MGO_HOME" || bad "$MGO_HOME/VERSION is missing"
  if su -s /bin/sh "$MGO_USER" -c "test -w '$MGO_HOME'" 2>/dev/null; then bad "$MGO_USER can write to $MGO_HOME (the application must be read-only for it)"; else pass "$MGO_HOME is read-only for $MGO_USER"; fi
  [[ $(stat -c %U:%a "$MGO_DATA" 2>/dev/null) == "$MGO_USER:700" ]] && pass "$MGO_DATA is $MGO_USER:700" || bad "$MGO_DATA should be $MGO_USER:700 (is $(stat -c %U:%a "$MGO_DATA" 2>/dev/null))"
  [[ $(stat -c %U:%G:%a "$MGO_ENV" 2>/dev/null) =~ ^root:($MGO_USER|root):(640|600)$ ]] && pass "$MGO_ENV is not world-readable" || bad "$MGO_ENV must be root:$MGO_USER 640 (token inside); is $(stat -c %U:%G:%a "$MGO_ENV" 2>/dev/null)"

  info "services"
  local s
  for s in mgo-xvfb mgo; do
    svc_active $s && pass "$s is active" || bad "$s is not active (mgo logs)"
    systemctl is-enabled --quiet $s && pass "$s starts at boot" || bad "$s is not enabled"
  done
  local show
  show=$(systemctl show mgo -p User -p NoNewPrivileges -p ProtectSystem -p PrivateTmp -p MemoryMax -p TasksMax -p CPUQuotaPerSecUSec 2>/dev/null | tr '\n' ' ')
  [[ $show == *"User=$MGO_USER"* && $show == *NoNewPrivileges=yes* && $show == *ProtectSystem=strict* && $show == *PrivateTmp=yes* ]] && pass "sandbox active: $show" || bad "systemd sandbox is not applied: $show"
  [[ $show != *MemoryMax=infinity* && $show != *TasksMax=infinity* ]] && pass "cgroup limits set (memory, tasks, cpu)" || bad "cgroup limits are missing"
  local up
  up=$(ps -o user= -C java 2>/dev/null | sort -u | tr '\n' ' ' || true)
  [[ -z $up || $up == "$MGO_USER " ]] && pass "emulator processes run as $MGO_USER" || bad "java runs as: $up"

  info "access"
  local json code token
  if json=$(health_json); then
    [[ $(jq -r .ok <<<"$json") == true ]] && pass "API health ok (MGO $(jq -r .version <<<"$json"), KEmulator $(jq -r '.kemulator.commit' <<<"$json" | cut -c1-9))" || bad "API reports a problem: $json"
    [[ $(jq -r .version <<<"$json") == "$(version)" ]] && pass "running version matches the installed release" || meh "running version $(jq -r .version <<<"$json") differs from $(version): restart pending?"
  else
    bad "API does not answer on 127.0.0.1:$(port)"
  fi
  token=$(env_get AUTH_TOKEN)
  if [[ ${#token} -ge 16 ]]; then
    pass "access token is set (${#token} characters)"
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:$(port)/api/games" || true)
    [[ $code == 401 ]] && pass "API rejects requests without the token (401)" || bad "API answered $code without a token"
  else
    bad "AUTH_TOKEN is missing or shorter than 16 characters"
  fi
  [[ $(env_get HOST) == 127.0.0.1 ]] && pass "listens on loopback only" || meh "listens on $(env_get HOST):$(port): keep it on a private network, never forward the port to the internet (docs/PROXMOX.md)"
  [[ -n $(env_get KEM_LAUNCH_WRAPPER) ]] && pass "games run without network (own netns)" || meh "games can use the network (mgo network deny)"
  if [[ -n $(env_get KEM_LAUNCH_WRAPPER) ]]; then
    su -s /bin/sh "$MGO_USER" -c 'unshare --user --map-current-user --net true' 2>/dev/null && pass "unprivileged user namespaces work (needed for the network isolation)" ||
      bad "network isolation is configured but unshare fails: enable nesting for the container (Options > Features > Nesting) or run: mgo network allow"
  fi
  [[ -e /sys/fs/cgroup/cgroup.controllers ]] && pass "cgroup v2" || meh "cgroup v2 not detected"

  info "library"
  local lib
  lib=$(jq -r '.settings.libraryPath // empty' "$MGO_DATA/settings.json" 2>/dev/null || true)
  if [[ -z $lib ]]; then
    pass "no library folder selected (uploads only)"
  elif runuser -u "$MGO_USER" -- test -r "$lib" -a -x "$lib" 2>/dev/null; then
    pass "library folder $lib is readable by $MGO_USER"
  else
    bad "library folder $lib is missing or not readable by $MGO_USER (is the host folder still mounted? mgo library)"
  fi
  [[ -f $MGO_DATA/secrets.json ]] && { [[ $(stat -c %a "$MGO_DATA/secrets.json") == 600 ]] && pass "secrets.json is mode 600" || bad "secrets.json must be mode 600"; }

  info "backups"
  local newest age
  newest=$(find "$MGO_BACKUPS" -maxdepth 1 -name 'mgo-*.tar.gz' -printf '%T@\n' 2>/dev/null | sort -rn | head -n1)
  if [[ -n $newest ]]; then
    age=$((($(date +%s) - ${newest%.*}) / 86400))
    ((age <= 14)) && pass "last backup is $age day(s) old" || meh "last backup is $age days old (mgo backup, or schedule a Proxmox/PBS backup of the container)"
  else
    meh "no backup yet (mgo backup)"
  fi
  if ((online)); then
    info "updates"
    if resolve_release latest 2>/dev/null; then
      version_gt "$REL_VERSION" "$(version)" && meh "update available: $REL_VERSION (mgo update)" || pass "up to date ($REL_VERSION)"
    else
      meh "cannot reach the release server"
    fi
  fi
  printf '\n%d problem(s), %d warning(s)\n' "$FAILS" "$WARNS"
  ((FAILS == 0))
}

usage() {
  cat <<E
mgo $(version) - manage this MGO installation

  mgo status [--json]            versions, services, health, URL, data size
  mgo update [--check] [--to vX] [--yes]
                                 verified update from a MGO release; backup first, health check, automatic rollback
  mgo backup [--out PATH] [--no-games] [--stop]
                                 archive of the SQLite library, RMS saves, games, web settings (incl. the MobyGames key), MobyGames data and configuration
  mgo restore FILE [--yes] [--with-config] [--only db,saves,games,settings,metadata,config]
  mgo rollback                   switch back to the previous release (kept after every update)
  mgo logs [-f] [-n N]           journal of mgo and mgo-xvfb
  mgo doctor [--online]          check the installation, sandbox, limits and access
  mgo token [--rotate]           show or replace the access token
  mgo network [deny|allow]       network access of games (default: none)
  mgo library [status]           game library folders: mounted? readable by the service user?
E
}

main() {
  local c=${1:-help}
  shift || true
  case $c in
  status) cmd_status "$@" ;;
  update) cmd_update "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  rollback) cmd_rollback "$@" ;;
  logs) cmd_logs "$@" ;;
  doctor) cmd_doctor "$@" ;;
  token) cmd_token "$@" ;;
  network) cmd_network "$@" ;;
  library) cmd_library "$@" ;;
  version | --version) version ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
  esac
}
main "$@"
